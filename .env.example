APP_NAME="Отзывы с Яндекс.Карт"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Port the site is published on by docker compose.
APP_PORT=8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Moscow

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=reviews
DB_USERNAME=reviews
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret
DB_FORWARD_PORT=13306

# --- Queue, cache, session --------------------------------------------------
# Parsing happens in queued jobs, so a real queue driver is required in
# production; `sync` would block the HTTP request for ~20 seconds per card.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# --- SPA authentication -----------------------------------------------------
# The SPA is served from the same origin as the API, so this only needs the
# host(s) the site is reachable on.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# --- Seeded user ------------------------------------------------------------
# There is no registration: this account is created by the seeder.
SEED_USER_EMAIL=admin@example.com
SEED_USER_NAME="Администратор"
SEED_USER_PASSWORD=password

# --- Parser -----------------------------------------------------------------
# Yandex serves 50 reviews per page and stops after 12 pages (~600 reviews).
# Raising this will not yield more data.
YANDEX_MAX_PAGES=12
YANDEX_TIMEOUT=30
YANDEX_MAX_ATTEMPTS=3

# Randomised pause between page requests, in milliseconds. A fixed interval is
# itself a bot signature, hence the range.
YANDEX_THROTTLE_MIN_MS=400
YANDEX_THROTTLE_MAX_MS=900

# Optional proxy pool, comma separated:
# YANDEX_PROXIES="http://user:pass@1.2.3.4:8080,http://5.6.7.8:3128"
YANDEX_PROXIES=
YANDEX_PROXY_PARK_SECONDS=600

# --- Scheduled refresh ------------------------------------------------------
PARSING_REFRESH_ENABLED=true
PARSING_REFRESH_INTERVAL_HOURS=24
