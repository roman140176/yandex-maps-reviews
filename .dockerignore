.git
.gitignore
.github

# Installed inside the image, never copied in.
vendor
node_modules

# Built by the frontend stage.
public/build
public/hot

# Cached with dev packages resolved — copying it makes package:discover fail
# in a --no-dev build.
bootstrap/cache/*.php

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*

.env
.env.*
!.env.example
database/*.sqlite

tests
phpunit.xml
docs
README.md
